# ---- Build output ----------------------------------------------------------
# Compiled binaries and debug symbols. The .pdb files are ~17 MB each and embed
# absolute build paths from whoever compiled them, so they never belong in git.
#
# Any usermode/release*/ directory is build output, whatever it is named. They used
# to be listed one by one, which meant every new folder (release_probe, release_p4,
# release_v3...) showed up as untracked until someone remembered to add it - and the
# pile of near-identical exes made it easy to launch the wrong one.
usermode/release*/
usermode/out/
usermode/x64/
usermode/Debug/
usermode/Release/
*.obj
*.pdb
*.ilk
*.exp
*.lib
*.user
*.suo
.vs/

# ---- vcpkg -----------------------------------------------------------------
usermode/vcpkg_installed/
usermode/vcpkg_downloaded/
usermode/vcpkg_scripts/
usermode/vcpkg/
vcpkg_installed/

# ---- Node / frontend build -------------------------------------------------
webapp/node_modules/
webapp/dist/
webapp/.vite/
npm-debug.log*
yarn-error.log*
.pnpm-store/

# ---- Local machine config --------------------------------------------------
# config.json holds the local server IP the usermode pushes data to. Tracked
# config.json files are kept at localhost, but any per-machine variant that
# points at a LAN address or a tunnel should never be committed.
usermode/config.local.json
config.local.json
.env
.env.local
.env.*.local

# ---- Runtime caches --------------------------------------------------------
# models_cache.json is written by usermode at runtime: player name -> character
# model, so a dead player's portrait survives a round change. It is per-machine
# state, regenerated whenever the exe runs, and must never be committed.
models_cache.json
usermode/models_cache.json

# ---- Logs / editor ---------------------------------------------------------
*.log
*.tmp
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---- OS --------------------------------------------------------------------
ehthumbs.db
Desktop.ini
